{
  "name": "@arka-protocol/core",
  "version": "0.1.0",
  "description": "Pure, deterministic compliance rules engine for building regulatory and policy enforcement systems. Features bytecode compilation, multi-jurisdiction harmonization, time-travel simulation, and adaptive risk scoring.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "compliance",
    "rules-engine",
    "policy-engine",
    "regulatory",
    "governance",
    "risk-management",
    "fintech",
    "regtech",
    "aml",
    "kyc",
    "fraud-detection",
    "multi-jurisdiction",
    "bytecode",
    "deterministic",
    "time-travel",
    "audit",
    "enterprise"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arka-protocol/arka-core.git",
    "directory": "packages/arka-core"
  },
  "homepage": "https://www.arkaprotocol.com",
  "bugs": {
    "url": "https://github.com/arka-protocol/arka-core/issues"
  },
  "author": "ARKA Protocol",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@arka-protocol/types": "workspace:*",
    "@arka-protocol/utils": "workspace:*",
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  }
}
