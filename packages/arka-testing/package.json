{
  "name": "@arka-protocol/testing",
  "version": "0.1.0",
  "description": "Comprehensive testing utilities for ARKA Protocol - mocks, factories, fixtures, and test helpers for compliance rule engines, AML/KYC workflows, and plugin development",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    },
    "./factories": {
      "types": "./dist/factories/index.d.ts",
      "import": "./dist/factories/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "arka",
    "arka-protocol",
    "testing",
    "test-utilities",
    "mocks",
    "fixtures",
    "factories",
    "compliance",
    "aml",
    "kyc",
    "rule-engine",
    "fintech",
    "regtech"
  ],
  "author": "ARKA Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/arka-protocol/arka-core.git",
    "directory": "packages/arka-testing"
  },
  "homepage": "https://www.arkaprotocol.com/docs",
  "bugs": {
    "url": "https://github.com/arka-protocol/arka-core/issues"
  },
  "dependencies": {
    "@arka-protocol/types": "workspace:*",
    "@arka-protocol/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
