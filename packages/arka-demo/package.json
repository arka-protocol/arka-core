{
  "name": "@arka/demo",
  "version": "1.0.0",
  "description": "ARKA Engine Demo Environment - Interactive demos for clients and developers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arka-demo": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "demo": "tsx src/cli/index.ts",
    "demo:standalone": "tsx src/cli/index.ts --mode=standalone",
    "demo:cli": "tsx src/cli/index.ts --mode=cli",
    "demo:server": "tsx src/cli/index.ts --mode=server",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arka/types": "workspace:*",
    "@arka/utils": "workspace:*",
    "@arka/core": "workspace:*",
    "@arka/crypto": "workspace:*",
    "@arka/testing": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "table": "^6.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "tsx": "^4.7.0"
  }
}
