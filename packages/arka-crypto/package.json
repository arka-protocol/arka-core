{
  "name": "@arka-protocol/crypto",
  "version": "0.1.0",
  "description": "Enterprise-grade cryptographic utilities for blockchain integration, featuring Merkle trees, canonical serialization, append-only event logs, and zero-knowledge proof compliance verification",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "cryptography",
    "merkle-tree",
    "blockchain",
    "zero-knowledge-proofs",
    "zkp",
    "audit-trail",
    "event-sourcing",
    "compliance",
    "data-integrity",
    "canonical-serialization",
    "hashing",
    "sha256",
    "enterprise",
    "arka-protocol"
  ],
  "author": "ARKA Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arka-protocol/arka-core.git",
    "directory": "packages/arka-crypto"
  },
  "homepage": "https://www.arkaprotocol.com",
  "bugs": {
    "url": "https://github.com/arka-protocol/arka-core/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@arka-protocol/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  }
}
