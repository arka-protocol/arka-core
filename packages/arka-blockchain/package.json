{
  "name": "@arka-protocol/blockchain",
  "version": "0.1.0",
  "description": "Multi-chain blockchain anchoring for compliance audit trails, rule NFTs, entity identity (DID), and compliance oracles. Supports Ethereum, Solana, Cosmos, Polkadot, Hyperledger Fabric, and AWS Managed Blockchain.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./adapters/hyperledger": {
      "types": "./dist/adapters/hyperledger.d.ts",
      "import": "./dist/adapters/hyperledger.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters/memory.d.ts",
      "import": "./dist/adapters/memory.js"
    },
    "./managed-blockchain": {
      "types": "./dist/managed-blockchain/index.d.ts",
      "import": "./dist/managed-blockchain/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "solana",
    "cosmos",
    "polkadot",
    "hyperledger",
    "compliance",
    "audit",
    "anchor",
    "merkle-tree",
    "nft",
    "did",
    "decentralized-identity",
    "oracle",
    "multi-chain",
    "cross-chain",
    "immutable",
    "tamper-proof",
    "regulatory",
    "fintech",
    "govtech",
    "enterprise"
  ],
  "author": "ARKA Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arka-protocol/arka-core.git",
    "directory": "packages/arka-blockchain"
  },
  "homepage": "https://www.arkaprotocol.com/docs",
  "bugs": {
    "url": "https://github.com/arka-protocol/arka-core/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@arka-protocol/types": "workspace:*",
    "@arka-protocol/crypto": "workspace:*",
    "@arka-protocol/utils": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-managedblockchain": "^3.500.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-managedblockchain": "^3.0.0",
    "fabric-network": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-managedblockchain": {
      "optional": true
    },
    "fabric-network": {
      "optional": true
    }
  }
}
