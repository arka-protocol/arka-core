{
  "name": "@arka/plugin-sdk",
  "version": "0.1.0",
  "description": "SDK for building ARKA Protocol domain plugins",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arka/types": "workspace:*",
    "@arka/core": "workspace:*",
    "@arka/utils": "workspace:*",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  }
}
