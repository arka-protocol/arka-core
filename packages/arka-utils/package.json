{
  "name": "@arka-protocol/utils",
  "version": "0.1.0",
  "description": "Production-ready utility library for ARKA Protocol - includes logging, caching, resilience patterns, rate limiting, and more",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js",
      "require": "./dist/middleware/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js",
      "require": "./dist/cache/index.js"
    },
    "./resilience": {
      "types": "./dist/resilience/index.d.ts",
      "import": "./dist/resilience/index.js",
      "require": "./dist/resilience/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "import": "./dist/database/index.js",
      "require": "./dist/database/index.js"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js",
      "require": "./dist/metrics/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "arka",
    "arka-protocol",
    "utilities",
    "logging",
    "caching",
    "circuit-breaker",
    "rate-limiting",
    "resilience",
    "retry",
    "middleware",
    "express",
    "typescript",
    "policy-engine",
    "ai-governance"
  ],
  "author": "ARKA Protocol",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/arka-protocol/arka-core.git",
    "directory": "packages/arka-utils"
  },
  "homepage": "https://www.arkaprotocol.com",
  "bugs": {
    "url": "https://github.com/arka-protocol/arka-core/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@arka-protocol/types": "workspace:*",
    "pino": "^8.17.0"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  }
}
